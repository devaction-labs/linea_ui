<%!-- title: Language and your own trigger | text: locale="pt_BR" names months and weekdays, writes the panel in Portuguese and uses the 24-hour clock; labels overrides single words. The trigger slot replaces the input with any button. --%>
<div class="grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-2">
  <.datetime_picker
    id="dtp5-pt"
    name="dtp5_pt"
    label="Agendar para"
    locale="pt_BR"
    week_start={1}
    value="2026-10-14T15:45"
    today={~D[2026-10-14]}
  />
  <div class="flex items-end">
    <.datetime_picker id="dtp5-custom" name="dtp5_custom">
      <:trigger>
        <.button variant="outline" color="primary">Pick a date and time</.button>
      </:trigger>
    </.datetime_picker>
  </div>
</div>
