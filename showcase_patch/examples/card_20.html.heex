<%!-- title: Link card | text: A card inside an anchor is a link card: a size="xs" card with a hover background on the card. --%>
<div class="flex justify-center rounded-lg bg-slate-50 p-6 dark:bg-navy-900 sm:p-10">
  <a href="#" class="block w-full max-w-xs rounded-xl">
    <.card size="xs" class="transition hover:bg-slate-100 dark:hover:bg-navy-600">
      <.card_header>
        <.card_heading>Documentation</.card_heading>
        <.card_subheading>Guides and API reference</.card_subheading>
        <.card_actions><.icon name="huge-arrow-up-right-01" class="size-4" /></.card_actions>
      </.card_header>
    </.card>
  </a>
</div>
