<%!-- title: Divided | text: body="divided" puts hairlines between the parts; divider="inset" stops them at the content edges. --%>
<div class="grid gap-6 rounded-lg bg-slate-50 p-6 dark:bg-navy-900 sm:p-10 md:grid-cols-2">
  <.card body="divided">
    <.card_header>
      <.card_heading>Storage</.card_heading>
      <.card_actions><.button size="xs" variant="outline">Upgrade</.button></.card_actions>
    </.card_header>
    <.card_body>
      <p class="text-base text-slate-700 dark:text-navy-50">32 GB</p>
      <p>of 100 GB</p>
    </.card_body>
    <.card_footer><span class="text-xs">Updated just now</span></.card_footer>
  </.card>
  <.card body="divided" divider="inset">
    <.card_header>
      <.card_heading>Storage</.card_heading>
      <.card_actions><.button size="xs" variant="outline">Upgrade</.button></.card_actions>
    </.card_header>
    <.card_body>
      <p class="text-base text-slate-700 dark:text-navy-50">32 GB</p>
      <p>of 100 GB</p>
    </.card_body>
    <.card_footer><span class="text-xs">Updated just now</span></.card_footer>
  </.card>
</div>
