<%!-- title: Country, order and set | text: country starts the field elsewhere, country_order lists countries first in the picker, countries limits it to a set and except removes some. locale picks the language of the names. --%>
<div class="grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-2">
  <.phone_input
    name="pi2_us"
    country="US"
    country_order={~w(US CA MX)}
    locale="en"
    label="United States first"
    placeholder="(201) 555-0123"
  />
  <.phone_input
    name="pi2_pt"
    country="PT"
    country_order={~w(PT BR)}
    label="Portugal and Brazil first"
    placeholder="912 345 678"
  />
  <.phone_input
    name="pi2_set"
    countries={~w(BR AR UY PY CL)}
    label="Only the Southern Cone"
    help="countries limits the picker to these."
  />
  <.phone_input
    name="pi2_except"
    except={~w(KP IR SY)}
    label="Every country except three"
    help="except removes some from the picker."
  />
</div>
