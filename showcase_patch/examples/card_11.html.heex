<%!-- title: Image bleed | text: card_bleed makes an image fill the body up to its rounded edges while the footer keeps its padding; shown with the inset treatment and with edges="top". --%>
<div class="grid grid-cols-1 gap-4 rounded-lg bg-slate-50 p-4 dark:bg-navy-900 sm:gap-5 lg:grid-cols-2">
  <.card body="inset">
    <.card_body>
      <.card_bleed>
        <div class="h-32 bg-gradient-to-r from-sky-400 to-indigo-500"></div>
      </.card_bleed>
    </.card_body>
    <.card_footer align="between">
      <span>Cover</span>
      <.button size="sm">Download</.button>
    </.card_footer>
  </.card>
  <.card>
    <.card_bleed edges="top">
      <div class="h-32 bg-gradient-to-br from-amber-400 to-orange-600"></div>
    </.card_bleed>
    <.card_header class="pt-4">
      <.card_heading>Edges</.card_heading>
      <.card_subheading>edges="top" bleeds to the top and the sides.</.card_subheading>
    </.card_header>
  </.card>
</div>
