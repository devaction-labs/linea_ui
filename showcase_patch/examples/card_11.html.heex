<%!-- title: Seamless | text: body="seamless" (the default) keeps header, body and footer on one surface and spaces them with the card's padding. --%>
<div class="flex justify-center rounded-lg bg-slate-50 p-6 dark:bg-navy-900 sm:p-10">
  <.card class="w-full max-w-sm">
    <.card_header>
      <.card_heading>Notifications</.card_heading>
      <.card_subheading>Choose what you hear about</.card_subheading>
    </.card_header>
    <.card_body class="space-y-4">
      <.switch name="card11_a" label="Product updates" checked wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card11_b" label="Weekly digest" wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card11_c" label="Security alerts" checked wrapper_class="w-full justify-between" label_position="left" />
    </.card_body>
  </.card>
</div>
