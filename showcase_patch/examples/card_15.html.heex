<%!-- title: Separated | text: body="separated" tints the header and the footer as bands and leaves the body on the card's surface. --%>
<div class="flex justify-center rounded-lg bg-slate-50 p-6 dark:bg-navy-900 sm:p-10">
  <.card body="separated" class="w-full max-w-sm">
    <.card_header>
      <.card_heading>Storage</.card_heading>
    </.card_header>
    <.card_body>
      <p class="text-base text-slate-700 dark:text-navy-50">32 GB</p>
      <p>of 100 GB</p>
    </.card_body>
    <.card_footer><span class="text-xs">Updated just now</span></.card_footer>
  </.card>
</div>
