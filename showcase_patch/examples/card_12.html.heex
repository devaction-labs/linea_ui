<%!-- title: Table bleed | text: A table with bleed runs its rows edge to edge in the card while its content stays aligned with the card's. --%>
<.card body="flush" class="max-w-xl">
  <.card_header>
    <.card_heading>Team</.card_heading>
    <.card_subheading>Two people</.card_subheading>
    <.card_actions><.button size="xs" variant="flat">Invite</.button></.card_actions>
  </.card_header>
  <.table
    id="card-team"
    rows={[%{name: "Ana", job: "Developer"}, %{name: "Bo", job: "Designer"}]}
    variant="hoverable"
    rounded="none"
    bleed
  >
    <:col :let={person} label="Name">{person.name}</:col>
    <:col :let={person} label="Job">{person.job}</:col>
  </.table>
</.card>
