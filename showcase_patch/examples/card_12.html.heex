<%!-- title: Inset | text: The body is a panel of its own inside the card, with corners concentric to the card's. On a tinted card it is raised; on a plain one it is a recessed well. --%>
<div class="grid gap-6 rounded-lg bg-slate-50 p-6 dark:bg-navy-900 sm:p-10 md:grid-cols-2">
  <.card body="inset" variant="soft">
    <.card_header>
      <.card_heading>Notifications</.card_heading>
      <.card_subheading>Choose what you hear about</.card_subheading>
    </.card_header>
    <.card_body class="space-y-4">
      <.switch name="card12_a" label="Product updates" checked wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card12_b" label="Weekly digest" wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card12_c" label="Security alerts" checked wrapper_class="w-full justify-between" label_position="left" />
    </.card_body>
  </.card>
  <.card body="inset">
    <.card_header>
      <.card_heading>Notifications</.card_heading>
      <.card_subheading>Choose what you hear about</.card_subheading>
    </.card_header>
    <.card_body class="space-y-4">
      <.switch name="card12_d" label="Product updates" checked wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card12_e" label="Weekly digest" wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card12_f" label="Security alerts" checked wrapper_class="w-full justify-between" label_position="left" />
    </.card_body>
  </.card>
</div>
