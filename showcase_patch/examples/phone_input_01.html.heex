<%!-- title: Basic phone input | text: A country picker with the flag and calling code beside the number. The field starts in Brazil, shows the national format as you type, and the form gets the E.164 number. --%>
<.form for={@form} id="pi1-form" phx-change="demo:validate" class="max-w-xl">
  <.phone_input field={@form[:pi1_phone]} label="Phone number" placeholder="(11) 91234-5678" />
  <p class="mt-2 text-xs-plus text-slate-400 dark:text-navy-300">
    Server has
    <.inline_code>{inspect(@form[:pi1_phone].value)}</.inline_code>
  </p>
</.form>
