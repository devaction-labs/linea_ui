<%!-- title: Variants, shapes and sizes | text: variant outlined or filled, shape rounded or pill, size sm, md and lg, as in input. --%>
<div class="grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-2">
  <.phone_input name="pi3_outlined" label="Outlined" value="+5511912345678" />
  <.phone_input name="pi3_filled" label="Filled" variant="filled" value="+5511912345678" />
  <.phone_input name="pi3_pill" label="Pill" shape="pill" value="+5511912345678" />
  <.phone_input
    name="pi3_filled_pill"
    label="Filled pill"
    variant="filled"
    shape="pill"
    value="+5511912345678"
  />
  <div class="space-y-4 sm:col-span-2">
    <.phone_input
      :for={size <- ~w(sm md lg)}
      name={"pi3_#{size}"}
      label={"Size #{size}"}
      size={size}
      value="+351912345678"
    />
  </div>
</div>
