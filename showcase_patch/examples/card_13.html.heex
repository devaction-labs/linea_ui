<%!-- title: Flush | text: Like inset, but the panel runs to the card's sides. --%>
<div class="grid gap-6 rounded-lg bg-slate-50 p-6 dark:bg-navy-900 sm:p-10 md:grid-cols-2">
  <.card body="flush" variant="soft">
    <.card_header>
      <.card_heading>Notifications</.card_heading>
      <.card_subheading>Choose what you hear about</.card_subheading>
    </.card_header>
    <.card_body class="space-y-4">
      <.switch name="card13_a" label="Product updates" checked wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card13_b" label="Weekly digest" wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card13_c" label="Security alerts" checked wrapper_class="w-full justify-between" label_position="left" />
    </.card_body>
  </.card>
  <.card body="flush">
    <.card_header>
      <.card_heading>Notifications</.card_heading>
      <.card_subheading>Choose what you hear about</.card_subheading>
    </.card_header>
    <.card_body class="space-y-4">
      <.switch name="card13_d" label="Product updates" checked wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card13_e" label="Weekly digest" wrapper_class="w-full justify-between" label_position="left" />
      <.switch name="card13_f" label="Security alerts" checked wrapper_class="w-full justify-between" label_position="left" />
    </.card_body>
  </.card>
</div>
