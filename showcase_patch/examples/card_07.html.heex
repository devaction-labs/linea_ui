<%!-- title: Profile | text: An inset, soft card of size lg. The header has a heading, a subheading and a ghost icon button in its corner; the body is a raised panel with the form; the footer holds a supporting text and the actions. --%>
<div class="flex justify-center rounded-lg bg-slate-50 p-6 dark:bg-navy-900 sm:p-10">
  <.card body="inset" variant="soft" size="lg" class="w-full max-w-sm">
    <.card_header>
      <.card_heading>Profile</.card_heading>
      <.card_subheading>Make yourself at home</.card_subheading>
      <.card_actions>
        <.button icon size="sm" variant="flat" aria-label="More">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.75" /><circle cx="12" cy="12" r="1.75" /><circle cx="19" cy="12" r="1.75" /></svg>
        </.button>
      </.card_actions>
    </.card_header>
    <.card_body class="space-y-6">
      <.input name="card07_name" label="Name" value="Olivia Martin" />
      <.textarea name="card07_bio" label="Bio" rows={3} value="Designer, hiker, coffee person." />
    </.card_body>
    <.card_footer>
      <span class="text-xs">All changes saved</span>
      <.card_actions>
        <.button size="sm" variant="flat">Cancel</.button>
        <.button size="sm" color="primary">Save</.button>
      </.card_actions>
    </.card_footer>
  </.card>
</div>
