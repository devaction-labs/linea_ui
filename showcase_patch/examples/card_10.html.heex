<%!-- title: Sizes | text: size="xs", "sm", "md" and "lg" set the padding, the corners, the type and the spacing between parts; shown here with body="separated" and a small button in the header. --%>
<div class="grid gap-5 rounded-lg bg-slate-50 p-6 dark:bg-navy-900 sm:grid-cols-2">
  <.card :for={size <- ~w(xs sm md lg)} size={size} body="separated">
    <.card_header>
      <.card_heading>Invoice 2041</.card_heading>
      <.card_actions><.button size="xs" variant="outline">Edit</.button></.card_actions>
    </.card_header>
    <.card_body>
      <p>Size {size}: three line items, $1,240.00 in total.</p>
    </.card_body>
    <.card_footer>
      <span class="text-xs">Due on March 3</span>
    </.card_footer>
  </.card>
</div>
