<%!-- title: Restrictions | text: min and max take "now", "today", a Date or ISO text; min_time and max_time bound every day; unavailable closes whole days, a daily time range (12:00-13:00, 22:00-02:00 crosses midnight) or one date-time. It takes a comma separated text or a list. --%>
<div class="grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-2">
  <.datetime_picker
    id="dtp3-window"
    name="dtp3_window"
    label="Office hours, no lunch"
    today={~D[2026-10-14]}
    min="today"
    max={~D[2026-10-30]}
    min_time="08:00"
    max_time="18:00"
    unavailable="12:00-13:00, 2026-10-16, 2026-10-15T09:00"
  />
  <.datetime_picker
    id="dtp3-future"
    name="dtp3_future"
    label="Only from now on"
    min="now"
    unavailable={[~D[2026-12-25], "22:00-02:00"]}
  />
</div>
