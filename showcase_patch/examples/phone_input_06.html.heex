<%!-- title: Validate on the server | text: The format only helps reading; the server must validate. Format.e164/2 reads the submitted value like the field does and rejects what cannot be a number. --%>
<.form for={@form} id="pi6-form" phx-change="demo:validate" class="max-w-xl">
  <.phone_input field={@form[:pi6_phone]} country="BR" label="Phone number" clearable />
  <p class="mt-2 text-xs-plus text-slate-400 dark:text-navy-300">
    Format.e164
    <.inline_code>
      {inspect(LineaUI.Components.PhoneInput.Format.e164(@form[:pi6_phone].value, "BR"))}
    </.inline_code>
  </p>
</.form>
