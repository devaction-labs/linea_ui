<%!-- title: Surfaces | text: variant="default" (shadow in light, elevation in dark), "muted", "soft", "outline" and "filled". The tints adapt to the color behind them, in light and dark. --%>
<div class="space-y-px overflow-hidden rounded-lg">
  <div class="flex flex-wrap gap-5 bg-slate-50 p-6 dark:bg-navy-900">
    <div :for={variant <- ~w(default muted soft outline filled)} class="w-36">
      <p class="mb-1.5 text-xs text-slate-400 dark:text-navy-300">{variant}</p>
      <.card variant={variant}>
        <.card_header>
          <.card_heading>Storage</.card_heading>
          <.card_subheading>32 GB</.card_subheading>
        </.card_header>
      </.card>
    </div>
  </div>
</div>
